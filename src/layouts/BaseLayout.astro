---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
  tone?: 'paper' | 'red';
  footer?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const {
  title,
  description = 'Dac Vu, Head of Performance Marketing bei der rightmart Group. AI-first, Direct Response, Tracking und Attribution.',
  image = '/images/og-default.jpg',
  tone = 'paper',
  footer = true,
} = Astro.props;
const locale = { de: 'de_DE', en: 'en_US', vi: 'vi_VN' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#9c1220" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=boska@400,500,700&display=swap" rel="stylesheet" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{{ de: 'Zum Inhalt', en: 'Skip to content', vi: 'Bỏ qua đến nội dung' }[lang]}</a>
    <Header tone={tone} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}

    <script>
      import { initMotion } from '../lib/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
