---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLangFromUrl, useTranslations, switchLocale } from '../i18n/utils';
import { locales } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Seitentyp für strukturierte Daten */
  kind?: 'home' | 'page';
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('meta.description'), image = '/images/og-default.jpg', kind = 'page' } = Astro.props;
const SITE = 'https://dacreator.dev';
const abs = (p: string) => new URL(p, SITE).href;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = abs(path);
const alternates = locales.map((l) => ({ l, href: abs(switchLocale(new URL(canonical), l)) }));
const isHome = path === `/${lang}/`;
const person = {
  '@type': 'Person',
  '@id': `${SITE}/#dac`,
  name: 'Dac Vu',
  jobTitle: lang === 'de' ? 'Head of Performance Marketing' : 'Head of Performance Marketing',
  worksFor: { '@type': 'Organization', name: 'rightmart Group' },
  url: `${SITE}/${lang}/`,
  image: abs('/images/dac-portrait.webp'),
  knowsAbout: ['Performance Marketing', 'Direct Response', 'Server-Side Tracking', 'Attribution', 'AI', 'Creative Strategy'],
  sameAs: ['https://github.com/jira369', 'https://linkedin.com/in/dacvu', 'https://substack.com/@dactales'],
};
const crumbs = [{ name: 'Dac Vu', href: `/${lang}/` }];
if (!isHome) crumbs.push({ name: title.split(/\s[|:]\s|,\s/)[0], href: path });
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${SITE}/#site`, url: SITE, name: 'Dac Vu', inLanguage: lang, publisher: { '@id': `${SITE}/#dac` } },
  { '@type': 'WebPage', '@id': `${canonical}#page`, url: canonical, name: title, description, inLanguage: lang, isPartOf: { '@id': `${SITE}/#site` }, about: { '@id': `${SITE}/#dac` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
  },
];
if (isHome || kind === 'home') graph.unshift(person);
else graph.unshift({ '@type': 'Person', '@id': `${SITE}/#dac`, name: 'Dac Vu', url: `${SITE}/${lang}/` });
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const locale = { de: 'de_DE', en: 'en_US', vi: 'vi_VN' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a090b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dac Vu" />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dac Vu, Head of Performance Marketing bei der rightmart Group" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(image)} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchLocale(new URL(canonical), 'de'))} />
    <meta name="author" content="Dac Vu" />
    <script type="application/ld+json" set:html={jsonLd} is:inline></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotion } from '../lib/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
