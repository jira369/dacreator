---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.id.startsWith('de/'))
    .map((project) => ({
      params: { slug: project.id.replace('de/', '') },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Dac Vu`} description={project.data.description}>
  <article class="pt-32 pb-20 px-6">
    <div class="mx-auto max-w-3xl">
      <a
        href="/de/projects"
        class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors mb-8"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Zurück zu Projekte
      </a>

      <div class="p-6 sm:p-8 bg-surface rounded-2xl border border-border mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-3">{project.data.title}</h1>
        <p class="text-lg text-text-muted mb-6">{project.data.description}</p>
        <div class="flex flex-wrap gap-2 mb-6">
          {project.data.tags.map((tag: string) => (
            <span class="px-3 py-1 text-sm text-text-muted bg-background rounded-lg border border-border">{tag}</span>
          ))}
        </div>
        <div class="flex items-center gap-4">
          {project.data.github && (
            <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-background border border-border rounded-lg hover:border-accent/50 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          )}
          {project.data.live && (
            <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-accent text-background font-medium rounded-lg hover:bg-accent-light transition-colors">Live Demo</a>
          )}
        </div>
      </div>

      <div class="prose prose-lg max-w-none project-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .project-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--color-text-primary); }
  .project-content h3 { margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1rem; font-weight: 600; color: var(--color-accent-light); }
  .project-content > h2 + p, .project-content > h2 + ul, .project-content > h2 + h3 { margin-top: 0; }
  .project-content ul { list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .project-content ul li { padding: 0.75rem 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.75rem; font-size: 0.875rem; line-height: 1.5; color: var(--color-text-muted); }
  .project-content ul li strong { color: var(--color-text-primary); font-weight: 600; }
  .project-content > p { color: var(--color-text-muted); font-size: 0.9375rem; line-height: 1.75; }
  .project-content > h2:last-of-type + ul { flex-direction: row; flex-wrap: wrap; gap: 0.5rem; }
  .project-content > h2:last-of-type + ul li { padding: 0.375rem 0.75rem; font-size: 0.8125rem; background: var(--color-background); }
</style>
