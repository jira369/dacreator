---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum — da(creator)">
  <section class="py-32 px-6">
    <div class="mx-auto max-w-3xl">
      <a href="/vi" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l7 7m-7-7l7-7" />
        </svg>
        Back
      </a>

      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-12">Impressum</h1>

      <div class="prose prose-invert max-w-none space-y-8 text-text-muted leading-relaxed">
        <div>
          <h2 class="text-xl font-semibold text-text-primary mb-3">Angaben gemäß § 5 TMG</h2>
          <p>Dac Vu<br />Hastedter Heerstraße 323<br />28207 Bremen<br />Deutschland</p>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-text-primary mb-3">Kontakt</h2>
          <p>E-Mail: dacvudinh@gmail.com</p>
        </div>
        <div>
