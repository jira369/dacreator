---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../PageHead.astro';
import { render } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale; post: any }
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
const loc = { de: 'de-DE', en: 'en-US', vi: 'vi-VN' }[lang];
---

<BaseLayout title={`${post.data.title} | Dac Vu`} description={post.data.description}>
  <article class="page wrap">
    <PageHead title={post.data.title} lead={post.data.description} />
    <p class="small" style="margin-top: 24px">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(loc, { year: 'numeric', month: 'long', day: 'numeric' })}</time>{post.data.tags.length ? `, ${post.data.tags.join(', ')}` : ''}
    </p>

    <div class="prose-site" style="margin-top: clamp(40px, 6vw, 80px)"><Content /></div>
    <p style="margin-top: 64px"><a class="link-plain" href={`/${lang}/blog`}>{t('blog.back')}</a></p>
  </article>
</BaseLayout>
