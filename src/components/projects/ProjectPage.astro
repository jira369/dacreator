---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RightmartShowcase from './RightmartShowcase';
import { logoFor, monogram } from '../../data/logos';
import { render } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale; project: any }
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout title={`${d.title} | Dac Vu`} description={d.description}>
  <article class="pt-32 sm:pt-40 pb-12 px-6">
    <div class="mx-auto max-w-5xl">
      <div data-reveal class="p-6 sm:p-8 bg-surface rounded-2xl border border-border mb-10">
        {d.kind === 'employer' && (
          <div class="has-logo h-10 mb-6 flex items-center">
            {logoFor(d.title) ? <img src={logoFor(d.title)} alt={d.title} class="logo-img h-full w-auto max-w-[220px] object-contain" /> : <span class="mono-mark text-xl">{monogram(d.title)}</span>}
          </div>
        )}
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-3">
          <h1 class:list={["font-medium tracking-tight leading-[1.02]", d.title.length > 18 ? "text-[clamp(1.875rem,5.6vw,5.25rem)]" : "text-[clamp(2.75rem,6.4vw,6rem)]"]}>{d.title}</h1>
          {d.period && <span class="text-sm text-text-muted tabular-nums">{d.period}</span>}
        </div>
        {d.role && <p class="text-accent-light mb-3">{d.role}</p>}
        <p class="text-lg text-text-muted mb-6">{d.description}</p>
        <p class="text-sm text-text-muted mb-3">{t('projects.stack')}</p>
        <div class="flex flex-wrap gap-2 mb-6">
          {d.tags.map((tag: string) => <span class="has-logo inline-flex items-center gap-2 px-3 py-1 text-sm text-text-primary bg-background rounded-lg border border-border">{logoFor(tag) && <img src={logoFor(tag)} alt="" class="tag-logo logo-img" loading="lazy" />}{tag}</span>)}
        </div>
        <div class="flex flex-wrap items-center gap-3">
          {d.github && (
            <a href={d.github} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          )}
          {d.live && <a href={d.live} target="_blank" rel="noopener noreferrer" class="btn">Live</a>}
          {d.kind === 'project' && !d.github && <span class="text-sm text-text-muted">{t('projects.internal')}</span>}
        </div>
      </div>

      <div class="max-w-3xl">
      <div class="prose prose-lg max-w-none project-content">
        <Content />
      </div>

      {project.id.endsWith('rightmart') && <RightmartShowcase client:visible lang={lang} />}

      <p class="mt-16"><a class="link" href={`/${lang}/projects`}>{t('projects.back')}</a></p>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .project-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.02em; color: var(--color-text-primary); }
  .project-content h3 { margin-top: 1.75rem; margin-bottom: 0.75rem; font-size: 1.0625rem; font-weight: 600; color: var(--color-accent-light); }
  .project-content ul { list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .project-content li { position: relative; padding-left: 1.7em; color: var(--color-text-muted); }
  .project-content li strong { color: var(--color-text-primary); font-weight: 600; }
</style>
