---
import { getLangFromUrl, switchLocale } from '../i18n/utils';
import { locales, localeNames, type Locale } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const otherLocales = locales.filter((l) => l !== lang);
---

<div class="flex items-center gap-1.5">
  {otherLocales.map((locale) => (
    <a
      href={switchLocale(Astro.url, locale)}
      class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full border border-border text-text-muted hover:text-text-primary hover:border-accent/50 transition-all duration-200"
      aria-label={`Switch to ${localeNames[locale]}`}
    >
      <span class="text-accent">{localeNames[locale]}</span>
    </a>
  ))}
</div>
