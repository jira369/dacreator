---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import credits from '../../public/archive/credits.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const email = t('contact.email');
const [local, domain] = email.split('@');
---

<footer class="foot on-red">
  <div class="foot__top">
    <p>{t('footer.n1')}</p>
    <p>{t('footer.n2')}</p>
    <p>
      <a href="https://github.com/jira369" target="_blank" rel="noopener noreferrer">GitHub</a>,
      <a href="https://linkedin.com/in/dacvu" target="_blank" rel="noopener noreferrer"> LinkedIn</a>
    </p>
    <a class="up" href="#main">{t('footer.up')}</a>
  </div>

  <div>
    <a class="foot__mail" data-foot-mail href={`mailto:${email}`}>{local}<wbr />@{domain}</a>
    <div class="foot__meta">
      <span>
        <a href={getLocalizedPath('/impressum', lang)}>{t('footer.imprint')}</a>,
        <a href={getLocalizedPath('/datenschutz', lang)}> {t('footer.privacy')}</a>
      </span>
      <span>Bremen, {year}</span>
    </div>
    <p class="foot__credits">
      {t('footer.credits')}:
      {credits.map((c, i) => (
        <span>
          <a href={c.page} target="_blank" rel="noopener noreferrer">{c.title.split(' (')[0].slice(0, 70)}</a>, {c.creator.split(',')[0]},
          <a href={c.licenseUrl} target="_blank" rel="noopener noreferrer"> {c.license}</a>{i < credits.length - 1 ? '; ' : '.'}
        </span>
      ))}
    </p>
  </div>
</footer>
