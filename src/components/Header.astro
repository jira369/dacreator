---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import { locales, localeNames } from '../i18n/config';
import { switchLocale } from '../i18n/utils';

interface Props { tone?: 'paper' | 'sun' }
const { tone = 'paper' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = getLocalizedPath('/', lang);

const links = [
  { label: t('nav.role'), href: `${home}#role` },
  { label: t('nav.case'), href: `${home}#case` },
  { label: t('nav.tech'), href: `${home}#tech` },
  { label: t('nav.cv'), href: getLocalizedPath('/cv', lang) },
  { label: t('nav.projects'), href: getLocalizedPath('/projects', lang) },
  { label: t('nav.contact'), href: `${home}#contact` },
];
const others = locales.filter((l) => l !== lang);
---

<header class="site-header" data-site-header style={tone === 'sun' ? '--header-ink:var(--on-sun)' : undefined}>
  <a class="brand" href={home}>Dac Vu</a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn data-open={t('nav.close')} data-closed={t('nav.menu')}>{t('nav.menu')}</button>
  <nav id="site-nav" aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <span class="lang">
      {others.map((l) => <a href={switchLocale(Astro.url, l)} hreflang={l} lang={l}>{localeNames[l]}</a>)}
    </span>
  </nav>
</header>

<script>
  function bind() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const btn = header?.querySelector<HTMLButtonElement>('[data-menu-btn]');
    if (!header || !btn) return;
    btn.onclick = () => {
      const open = header.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.open! : btn.dataset.closed!;
    };
    header.querySelectorAll('nav a').forEach((a) =>
      a.addEventListener('click', () => {
        header.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.textContent = btn.dataset.closed!;
      }),
    );
  }
  document.addEventListener('astro:page-load', bind);
</script>
