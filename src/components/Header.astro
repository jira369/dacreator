---
import LanguageToggle from './LanguageToggle.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', lang) },
  { label: t('nav.projects'), href: getLocalizedPath('/projects', lang) },
  { label: t('nav.blog'), href: getLocalizedPath('/blog', lang) },
  { label: t('nav.contact'), href: '#contact' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a
      href={getLocalizedPath('/', lang)}
      class="text-lg font-bold tracking-tight text-text-primary hover:text-accent-light transition-colors"
    >
      dac<span class="text-accent">.</span>vu
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm text-text-muted hover:text-text-primary transition-colors duration-200 relative group"
          >
            {item.label}
            <span class="absolute -bottom-1 left-0 w-0 h-px bg-accent group-hover:w-full transition-all duration-300" />
          </a>
        ))
      }
      <LanguageToggle />
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
    >
      <span class="w-5 h-px bg-text-primary transition-all duration-300 origin-center" id="menu-line-1"></span>
      <span class="w-5 h-px bg-text-primary transition-all duration-300" id="menu-line-2"></span>
      <span class="w-3 h-px bg-text-primary transition-all duration-300 origin-center" id="menu-line-3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 top-16 bg-background/95 backdrop-blur-xl -translate-y-full opacity-0 pointer-events-none transition-all duration-500 z-40"
  >
    <div class="flex flex-col items-center justify-center gap-8 h-full">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-2xl font-medium text-text-muted hover:text-text-primary transition-colors mobile-nav-link"
          >
            {item.label}
          </a>
        ))
      }
      <LanguageToggle />
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    let menuOpen = false;

    // Scroll effect
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (!header) return;

      if (currentScroll > 50) {
        header.classList.add('bg-background/80', 'backdrop-blur-xl', 'border-b', 'border-border');
      } else {
        header.classList.remove('bg-background/80', 'backdrop-blur-xl', 'border-b', 'border-border');
      }

      lastScroll = currentScroll;
    });

    // Mobile menu toggle
    mobileMenuBtn?.addEventListener('click', () => {
      menuOpen = !menuOpen;
      if (mobileMenu) {
        if (menuOpen) {
          mobileMenu.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          mobileMenu.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
          mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        }
      }

      // Animate hamburger
      const line1 = document.getElementById('menu-line-1');
      const line2 = document.getElementById('menu-line-2');
      const line3 = document.getElementById('menu-line-3');
      if (menuOpen) {
        line1?.classList.add('rotate-45', 'translate-y-[4px]');
        line2?.classList.add('opacity-0');
        line3?.classList.add('-rotate-45', '-translate-y-[4px]', 'w-5');
      } else {
        line1?.classList.remove('rotate-45', 'translate-y-[4px]');
        line2?.classList.remove('opacity-0');
        line3?.classList.remove('-rotate-45', '-translate-y-[4px]', 'w-5');
      }
    });

    // Close mobile menu on nav link click
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenuBtn?.click();
      });
    });
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
