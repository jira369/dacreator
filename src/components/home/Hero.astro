---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero on-red" aria-labelledby="hero-title">
  <div class="hero__head">
    <h1 id="hero-title">
      <span class="line"><span>{t('hero.title1')}</span></span>
      <span class="line"><span>{t('hero.title2')}</span></span>
    </h1>
    <p class="hero__lead" data-reveal>{t('hero.lead')}</p>
    <div class="hero__actions" data-reveal>
      <a class="btn" href="#contact">
        {t('hero.cta')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="link-plain" href="#case">{t('hero.cta2')}</a>
    </div>
  </div>
  <div class="hero__word" data-hero-word aria-hidden="true">{t('hero.word')}</div>
</section>
