---
import { useTranslations } from '../../i18n/utils';
import { accent, plain } from '../../lib/accent';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
import Mark from '../Mark.astro';
const pts = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({ h: t(`tech.p${n}` as 'tech.p1'), d: t(`tech.p${n}d` as 'tech.p1d') }));
---
<section class="section wrap" id="tech" aria-labelledby="tech-title">
  <div class="feat">
    <figure class="feat__photo" data-shutter>
      <img src="/images/dac-portrait.webp" width="1040" height="1333" alt={t('tech.photo')} loading="lazy" decoding="async" />
    </figure>
    <div class="feat__body">
      <h2 id="tech-title" data-reveal set:html={accent(t('tech.h'))} />
      <p data-reveal>{t('tech.p')}</p>
      <ul class="points">
        {pts.map((p) => <li data-reveal><h3><Mark class="wave" size={18} />{p.h}</h3><p>{p.d}</p></li>)}
      </ul>
    </div>
  </div>
</section>
