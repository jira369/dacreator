---
import { useTranslations } from '../../i18n/utils';
import { accent } from '../../lib/accent';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const nodes = [
  { k: 1, href: `/${lang}/#case` },
  { k: 2, href: `/${lang}/#work` },
  { k: 3, href: `/${lang}/projects/marketingcockpit` },
  { k: 4, href: `/${lang}/cv#creative` },
  { k: 5, href: `/${lang}/projects/rightmart` },
  { k: 6, href: `/${lang}/projects` },
].map((n) => ({
  ...n,
  title: t(`dna.n${n.k}t` as 'dna.n1t'),
  short: t(`dna.n${n.k}k` as 'dna.n1k'),
  long: t(`dna.n${n.k}s` as 'dna.n1s'),
}));
---

<section class="section wrap" id="dna" aria-labelledby="dna-title" data-dna>
  <div class="dna__head">
    <h2 id="dna-title" data-reveal set:html={accent(t('dna.h'))} />
    <p data-reveal>{t('dna.sub')}</p>
  </div>
  <div class="dna__stage" data-dna-stage>
    <canvas aria-hidden="true"></canvas>
    <ul class="dna__nodes">
      {nodes.map((n, i) => (
        <li>
          <a class={`dna__node ${i % 2 ? 'is-alt' : ''}`} href={n.href}>
            <span class="dna__dot" aria-hidden="true"></span>
            <span class="dna__label"><b>{n.title}</b><i>{n.short}</i><em>{n.long}</em></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  function initDna() {
    const root = document.querySelector<HTMLElement>('[data-dna]');
    if (!root || root.dataset.ready) return;
    const stage = root.querySelector<HTMLElement>('[data-dna-stage]')!;
    const canvas = stage.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    root.dataset.ready = '1';
    root.classList.add('dna--live');

    const items = Array.from(root.querySelectorAll<HTMLAnchorElement>('.dna__node'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SUN = '236,122,69', APR = '246,179,148', INK = '240,238,242';
    const T = [0.1, 0.26, 0.42, 0.58, 0.74, 0.9];
    let W = 0, H = 0, R = 0, dpr = 1, rot = 0.4, vel = reduced ? 0 : 0.26;
    let active = 0, hold = false, drag = false, lastX = 0, moved = 0, visible = true, last = 0, idle = 0;

    // Bühne an den Viewport anpassen: Radius und Windungen hängen von Breite und Höhe ab
    function size() {
      const r = stage.getBoundingClientRect();
      W = r.width; H = r.height; dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      R = Math.max(70, Math.min(W * (W < 640 ? 0.2 : 0.15), 210));
      draw();
    }
    const turns = () => (H / Math.max(R, 1) > 4.2 ? 2.4 : 1.8);
    const pad = () => H * 0.07;
    const Y = (t: number) => pad() + t * (H - pad() * 2);
    const ang = (t: number, o: number) => rot + t * Math.PI * 2 * turns() + o;

    function draw() {
      const X = W / 2;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.globalCompositeOperation = 'source-over';
      ctx!.clearRect(0, 0, W, H);
      for (let t = 0.02; t < 0.99; t += 0.026) {
        const a = ang(t, 0), z = Math.abs(Math.sin(a));
        ctx!.strokeStyle = `rgba(${INK},${0.05 + 0.1 * z})`; ctx!.lineWidth = 1;
        ctx!.beginPath(); ctx!.moveTo(X + R * Math.cos(a), Y(t)); ctx!.lineTo(X - R * Math.cos(a), Y(t)); ctx!.stroke();
      }
      ctx!.globalCompositeOperation = 'lighter'; ctx!.lineCap = 'round';
      for (const [o, col] of [[0, SUN], [Math.PI, APR]] as const) {
        for (const [lw, al] of [[12, 0.05], [5, 0.18], [1.8, 0.95]]) {
          ctx!.lineWidth = lw;
          for (let t = 0; t < 1; t += 0.004) {
            const a = ang(t, o), z = (Math.sin(a) + 1) / 2;
            ctx!.strokeStyle = `rgba(${col},${al * (0.2 + 0.8 * z)})`;
            ctx!.beginPath(); ctx!.moveTo(X + R * Math.cos(a), Y(t)); ctx!.lineTo(X + R * Math.cos(ang(t + 0.004, o)), Y(t + 0.004)); ctx!.stroke();
          }
        }
      }
      ctx!.globalCompositeOperation = 'source-over';
      items.forEach((el, i) => {
        const o = i % 2 ? Math.PI : 0, a = ang(T[i], o), z = (Math.sin(a) + 1) / 2;
        const x = X + R * Math.cos(a), y = Y(T[i]), on = i === active;
        const lw = (el.querySelector('.dna__label') as HTMLElement).offsetWidth + 30;
        const right = x >= X ? W - x > lw : x < lw;
        el.style.transform = `translate(${x}px, ${y}px)`;
        el.style.opacity = String(on ? 1 : 0.55 + 0.45 * z);
        el.style.zIndex = String(on ? 20 : Math.round(z * 10) + 1);
        el.classList.toggle('is-right', right);
        el.classList.toggle('is-left', !right);
        el.classList.toggle('is-on', on);
        if (on) {
          ctx!.strokeStyle = `rgba(${SUN},.4)`; ctx!.lineWidth = 2;
          ctx!.beginPath(); ctx!.arc(x, y, 20, 0, 6.283); ctx!.stroke();
        }
      });
    }

    const setActive = (i: number) => { active = i; draw(); };
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      if (visible && !drag) {
        if (!hold) {
          rot += vel * dt; vel += ((reduced ? 0 : 0.26) - vel) * Math.min(dt * 2, 1);
          idle += dt; if (idle > 2.8) { idle = 0; active = (active + 1) % items.length; }
        }
        draw();
      }
      requestAnimationFrame(frame);
    }

    items.forEach((el, i) => {
      const on = () => { hold = true; idle = 0; setActive(i); };
      const off = () => { hold = false; idle = 0; };
      el.addEventListener('pointerenter', on);
      el.addEventListener('pointerleave', off);
      el.addEventListener('focus', on);
      el.addEventListener('blur', off);
    });
    stage.addEventListener('pointerdown', (e) => { drag = true; moved = 0; lastX = e.clientX; });
    stage.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - lastX; lastX = e.clientX; moved += Math.abs(dx);
      // Erst beim echten Ziehen einfangen, sonst erreicht ein Klick den Link nicht
      if (moved > 4 && !stage.hasPointerCapture?.(e.pointerId)) stage.setPointerCapture?.(e.pointerId);
      rot += dx * 0.009; vel = dx * 0.4; draw();
    });
    const end = () => { drag = false; };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    stage.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } moved = 0; }, true);

    new IntersectionObserver((en) => { visible = en[0].isIntersecting; }).observe(stage);
    new ResizeObserver(size).observe(stage);
    size();
    if (!reduced) requestAnimationFrame((n) => { last = n; frame(n); });
  }
  document.addEventListener('astro:page-load', initDna);
</script>
