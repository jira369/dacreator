---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = `/${lang}/`;
const nodes = [
  { k: 1, href: `${home}#case` },
  { k: 2, href: `${home}#work` },
  { k: 3, href: `/${lang}/projects/marketingcockpit` },
  { k: 4, href: `/${lang}/cv#creative` },
  { k: 5, href: `${home}#role` },
  { k: 6, href: `/${lang}/projects` },
].map((n) => ({ ...n, title: t(`dna.n${n.k}t` as 'dna.n1t'), sub: t(`dna.n${n.k}s` as 'dna.n1s') }));
---

<section class="dna on-dusk" id="dna" aria-labelledby="dna-title" data-dna>
  <div class="dna__head">
    <h2 id="dna-title" data-reveal>{t('dna.h')}</h2>
    <p data-reveal>{t('dna.sub')}</p>
  </div>
  <div class="dna__stage" data-dna-stage>
    <canvas class="dna__canvas" aria-hidden="true"></canvas>
    <ul class="dna__nodes">
      {nodes.map((n) => (
        <li>
          <a class="dna__node" href={n.href}>
            <span class="dna__dot" aria-hidden="true"></span>
            <span class="dna__label"><b>{n.title}</b><i>{n.sub}</i></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  function initDna() {
    const root = document.querySelector<HTMLElement>('[data-dna]');
    if (!root || root.dataset.ready) return;
    const stage = root.querySelector<HTMLElement>('[data-dna-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    root.dataset.ready = '1';
    root.classList.add('dna--live');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const css = getComputedStyle(document.documentElement);
    const col = (n: string, f: string) => (css.getPropertyValue(n).trim() || f);
    const SUN = col('--sun', '#E0693B');
    const APR = col('--apricot', '#F4A58A');
    const LINE = col('--on-dusk', '#F6EFEA');

    const items = Array.from(root.querySelectorAll<HTMLAnchorElement>('.dna__node'));
    const T = [0.07, 0.23, 0.39, 0.55, 0.71, 0.87];
    const TURNS = 2.1;
    let W = 0, H = 0, R = 0, dpr = 1;
    let hold = false;
    let rot = 0.6, vel = reduced ? 0 : 0.35, drag = false, moved = 0, lastX = 0, visible = true, last = 0;

    function size() {
      const r = stage.getBoundingClientRect();
      W = r.width; H = r.height; dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr; canvas.height = H * dpr;
      canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
      R = Math.min(W * 0.2, 250);
      draw();
    }
    const ang = (t: number, off = 0) => rot + t * TURNS * Math.PI * 2 + off;
    const pad = 28;
    const Y = (t: number) => pad + t * (H - pad * 2);

    function draw() {
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, W, H);
      const cx = W / 2;
      // rungs
      for (let t = 0.02; t < 0.99; t += 0.03) {
        const a = ang(t), x1 = cx + R * Math.cos(a), x2 = cx - R * Math.cos(a);
        const z = Math.sin(a);
        ctx!.globalAlpha = 0.14 + 0.2 * Math.abs(z);
        ctx!.strokeStyle = LINE; ctx!.lineWidth = 2;
        ctx!.beginPath(); ctx!.moveTo(x1, Y(t)); ctx!.lineTo(x2, Y(t)); ctx!.stroke();
      }
      // strands, back first
      for (const pass of [0, 1]) {
        for (let t = 0; t <= 1; t += 0.0035) {
          for (const s of [0, 1]) {
            const a = ang(t, s ? Math.PI : 0);
            const z = Math.sin(a);
            if ((pass === 0) !== (z < 0)) continue;
            const k = (z + 1) / 2;
            ctx!.globalAlpha = 0.25 + 0.75 * k;
            ctx!.fillStyle = s ? APR : SUN;
            ctx!.beginPath();
            ctx!.arc(cx + R * Math.cos(a), Y(t), 2.4 + 3.4 * k, 0, 6.283);
            ctx!.fill();
          }
        }
      }
      ctx!.globalAlpha = 1;
      // nodes
      items.forEach((el, i) => {
        const s = i % 2;
        const a = ang(T[i], s ? Math.PI : 0);
        const x = cx + R * Math.cos(a), y = Y(T[i]), z = Math.sin(a);
        const k = (z + 1) / 2;
        const lw = (el.querySelector('.dna__label') as HTMLElement).offsetWidth + 34;
        // Seite des Labels so wählen, dass es nie aus der Bühne ragt
        const right = x >= cx ? W - x > lw : x < lw;
        el.style.transform = `translate(${x}px, ${y}px) scale(${0.86 + 0.14 * k})`;
        el.style.opacity = String(0.62 + 0.38 * k);
        el.style.zIndex = String(Math.round(k * 10) + 1);
        el.classList.toggle('is-right', right);
        el.classList.toggle('is-left', !right);
        el.classList.toggle('is-alt', !!s);
      });
    }

    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      if (visible && !drag && !hold) {
        const base = reduced ? 0 : 0.35;
        vel += (base - vel) * Math.min(dt * 2, 1);
        if (Math.abs(vel) > 0.0005 || !reduced) { rot += vel * dt; draw(); }
      }
      requestAnimationFrame(frame);
    }

    items.forEach((el) => {
      el.addEventListener('pointerenter', () => { hold = true; });
      el.addEventListener('pointerleave', () => { hold = false; });
      el.addEventListener('focus', () => { hold = true; });
      el.addEventListener('blur', () => { hold = false; });
    });
    stage.addEventListener('pointerdown', (e) => { drag = true; moved = 0; lastX = e.clientX; });
    stage.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - lastX; lastX = e.clientX; moved += Math.abs(dx);
      // Erst beim echten Ziehen einfangen, sonst erreicht ein Klick den Link nicht
      if (moved > 4 && !stage.hasPointerCapture?.(e.pointerId)) stage.setPointerCapture?.(e.pointerId);
      rot += dx * 0.009; vel = dx * 0.5; draw();
    });
    const end = () => { drag = false; };
    stage.addEventListener('pointerup', end); stage.addEventListener('pointercancel', end);
    stage.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } moved = 0; }, true);

    new IntersectionObserver((en) => { visible = en[0].isIntersecting; }).observe(stage);
    new ResizeObserver(size).observe(stage);
    size();
    if (!reduced) requestAnimationFrame((n) => { last = n; frame(n); });
  }
  document.addEventListener('astro:page-load', initDna);
</script>
