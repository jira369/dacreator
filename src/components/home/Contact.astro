---
import { useTranslations } from '../../i18n/utils';
import ContactForm from './ContactForm';
import type { Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__inner">
    <h2 id="contact-title" class="contact__prompt" data-reveal>
      <span>{t('contact.l1')}</span>{t('contact.l2')}
    </h2>
    <p style="margin-top:14px" data-reveal>{t('contact.text')}</p>
    <div data-reveal><ContactForm client:visible lang={lang} /></div>
  </div>
  <figure class="contact__pic" data-reveal data-drift>
    <div><img src="/archive/workman-telephone-switchboard-shasta-dam.webp" width="1024" height="798" alt={t('contact.pic')} loading="lazy" decoding="async" /></div>
    <figcaption>{t('contact.pic')}</figcaption>
  </figure>
</section>
