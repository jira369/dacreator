---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ContactForm from './ContactForm';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-32 px-6" id="contact">
  <div class="mx-auto max-w-3xl text-center">
    <span
      data-animate
      class="text-accent font-medium text-sm tracking-widest uppercase mb-4 block"
    >
      {t('nav.contact')}
    </span>

    <h2
      data-animate
      data-animate-delay="0.1"
      class="text-4xl sm:text-6xl font-bold tracking-tight mb-6"
    >
      {t('contact.heading')}
    </h2>

    <p
      data-animate
      data-animate-delay="0.2"
      class="text-text-muted text-lg leading-relaxed mb-2 max-w-xl mx-auto"
    >
      {t('contact.text')}
    </p>

    <div data-animate data-animate-delay="0.3">
      <ContactForm client:visible lang={lang} />
    </div>
  </div>
</section>
