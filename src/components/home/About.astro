---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-32 px-6" id="about">
  <div class="mx-auto max-w-6xl">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <span
          data-animate
          data-animate-delay="0"
          class="text-accent font-medium text-sm tracking-widest uppercase mb-4 block"
        >
          {t('about.heading')}
        </span>
        <h2
          data-animate
          data-animate-delay="0.1"
          class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight"
        >
          {t('about.title1')}<br />
          <span class="text-text-muted">{t('about.title2')}</span>
        </h2>
      </div>

      <div data-animate data-animate-delay="0.2">
        <p class="text-text-muted leading-relaxed text-lg">
          {t('about.text')}
        </p>

        <div class="mt-8 grid grid-cols-2 gap-6">
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">8+</div>
            <div class="text-sm text-text-muted">{{ en: 'Years Experience', de: 'Jahre Erfahrung', vi: 'Năm kinh nghiệm' }[lang]}</div>
          </div>
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">6+</div>
            <div class="text-sm text-text-muted">{{ en: 'Companies', de: 'Unternehmen', vi: 'Công ty' }[lang]}</div>
          </div>
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">7+</div>
            <div class="text-sm text-text-muted">{{ en: 'Team Members Led', de: 'Teammitglieder geführt', vi: 'Thành viên đã lãnh đạo' }[lang]}</div>
          </div>
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">2</div>
            <div class="text-sm text-text-muted">{{ en: 'Companies Founded', de: 'Unternehmen gegründet', vi: 'Công ty đã sáng lập' }[lang]}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
