---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-32 px-6" id="about">
  <div class="mx-auto max-w-6xl">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <span
          data-animate
          data-animate-delay="0"
          class="text-accent font-medium text-sm tracking-widest uppercase mb-4 block"
        >
          {t('about.heading')}
        </span>
        <h2
          data-animate
          data-animate-delay="0.1"
          class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight"
        >
          {lang === 'en' ? 'Building digital' : 'Digitale Produkte'}<br />
          <span class="text-text-muted">{lang === 'en' ? 'experiences that matter.' : 'die zählen.'}</span>
        </h2>
      </div>

      <div data-animate data-animate-delay="0.2">
        <p class="text-text-muted leading-relaxed text-lg">
          {t('about.text')}
        </p>

        <div class="mt-8 grid grid-cols-2 gap-6">
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">5+</div>
            <div class="text-sm text-text-muted">{lang === 'en' ? 'Years Experience' : 'Jahre Erfahrung'}</div>
          </div>
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">10+</div>
            <div class="text-sm text-text-muted">{lang === 'en' ? 'Projects Delivered' : 'Projekte umgesetzt'}</div>
          </div>
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">3</div>
            <div class="text-sm text-text-muted">{lang === 'en' ? 'Companies Led' : 'Unternehmen geleitet'}</div>
          </div>
          <div class="p-4 bg-surface rounded-xl border border-border">
            <div class="text-3xl font-bold text-accent mb-1">&infin;</div>
            <div class="text-sm text-text-muted">{lang === 'en' ? 'Curiosity' : 'Neugier'}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
