---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const roles = [
  {
    title: t('experience.role1.title'),
    company: t('experience.role1.company'),
    period: t('experience.role1.period'),
    description: t('experience.role1.description'),
  },
  {
    title: t('experience.role2.title'),
    company: t('experience.role2.company'),
    period: t('experience.role2.period'),
    description: t('experience.role2.description'),
  },
  {
    title: t('experience.role3.title'),
    company: t('experience.role3.company'),
    period: t('experience.role3.period'),
    description: t('experience.role3.description'),
  },
];
---

<section class="py-32 px-6" id="experience">
  <div class="mx-auto max-w-6xl">
    <span
      data-animate
      class="text-accent font-medium text-sm tracking-widest uppercase mb-4 block"
    >
      {t('experience.heading')}
    </span>
    <h2
      data-animate
      data-animate-delay="0.1"
      class="text-4xl sm:text-5xl font-bold tracking-tight mb-16"
    >
      {lang === 'en' ? 'Where I\'ve' : 'Wo ich'} <span class="text-text-muted">{lang === 'en' ? 'worked.' : 'gearbeitet habe.'}</span>
    </h2>

    <div class="relative">
      <!-- Timeline line -->
      <div
        data-timeline-line
        class="absolute left-0 md:left-8 top-0 bottom-0 w-px bg-gradient-to-b from-accent via-accent/50 to-transparent"
      ></div>

      <div class="space-y-12">
        {roles.map((role, i) => (
          <div
            data-animate
            data-animate-delay={String(0.2 + i * 0.15)}
            class="relative pl-8 md:pl-20"
          >
            {/* Dot */}
            <div class="absolute left-0 md:left-8 top-2 -translate-x-1/2 w-3 h-3 rounded-full bg-accent ring-4 ring-background"></div>

            <div class="p-6 bg-surface rounded-2xl border border-border hover:border-accent/30 transition-colors duration-300">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-lg font-semibold">{role.title}</h3>
                  <p class="text-accent-light text-sm">{role.company}</p>
                </div>
                <span class="text-xs text-text-muted bg-background px-3 py-1 rounded-full border border-border whitespace-nowrap">
                  {role.period}
                </span>
              </div>
              <p class="text-text-muted text-sm leading-relaxed">{role.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
