---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillGroups = [
  {
    label: t('skills.marketing'),
    skills: ['Performance Marketing', 'SEA / Google Ads', 'Social Media Marketing', 'Influencer Marketing', 'Content Marketing', 'Branding', 'CRO', 'Paid Social', 'Native Ads'],
  },
  {
    label: t('skills.leadership'),
    skills: { en: ['Team Leadership', 'Project Management', 'Product Management', 'Process Optimization', 'People Management', 'Strategic Planning'], de: ['Teamleitung', 'Projektmanagement', 'Produktmanagement', 'Prozessoptimierung', 'Personalführung', 'Strategische Planung'], vi: ['Lãnh đạo nhóm', 'Quản lý dự án', 'Quản lý sản phẩm', 'Tối ưu quy trình', 'Quản lý nhân sự', 'Hoạch định chiến lược'] }[lang] || ['Team Leadership', 'Project Management', 'Product Management', 'Process Optimization', 'People Management', 'Strategic Planning'],
  },
  {
    label: t('skills.tools'),
    skills: ['WordPress', 'Adobe Illustrator', 'Figma', 'TikTok', 'Tracking & Analytics', 'Landing Pages', 'Grafikdesign', 'Google Analytics'],
  },
];
---

<section class="py-32 px-6" id="skills">
  <div class="mx-auto max-w-6xl">
    <span
      data-animate
      class="text-accent font-medium text-sm tracking-widest uppercase mb-4 block"
    >
      {t('skills.heading')}
    </span>
    <h2
      data-animate
      data-animate-delay="0.1"
      class="text-4xl sm:text-5xl font-bold tracking-tight mb-16"
    >
      {{ en: 'What I', de: 'Was ich', vi: 'Công cụ tôi' }[lang]} <span class="text-text-muted">{{ en: 'work with.', de: 'nutze.', vi: 'sử dụng.' }[lang]}</span>
    </h2>

    <div class="grid md:grid-cols-3 gap-8">
      {skillGroups.map((group, gi) => (
        <div data-animate data-animate-delay={String(0.2 + gi * 0.1)}>
          <h3 class="text-sm font-medium text-accent-light tracking-widest uppercase mb-6 pb-3 border-b border-border">
            {group.label}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="px-3 py-1.5 text-sm text-text-muted bg-surface rounded-lg border border-border hover:border-accent/40 hover:text-text-primary transition-all duration-200 cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
